{
  "name": "autocare-erp-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:studio": "npm run android:sync && cap open android",
    "android:aab": "npm run android:sync && cd android && gradlew bundleRelease",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:xcode": "npm run ios:sync && cap open ios",
    "windows:installer": "electron-builder --win nsis portable",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@e965/xlsx": "^0.20.3",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.alasly.autocare",
    "productName": "المحترف AutoCare",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
