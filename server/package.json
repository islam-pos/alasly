{
  "name": "autocare-erp-server",
  "version": "1.0.0",
  "description": "Backend API for AutoCare ERP System",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts src/services/coreValidation.test.ts src/services/itemImport.test.ts",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/migrate.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:production": "tsx prisma/productionSeed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "6.7.24",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "tar": "^7.5.22",
    "teleproto": "^1.229.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.19",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
